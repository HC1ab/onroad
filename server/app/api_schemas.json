{
  "area_crosswalks.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "area_crosswalks.schema.json",
    "title": "GET /api/areas/{adm_cd}/crosswalks?speed=&radius=",
    "description": "한 읍면동의 횡단보도 목록. 지역 상세 패널(F7)에 쓴다. 기본 정렬은 gap_s 내림차순.",
    "type": "object",
    "required": [
      "adm_cd",
      "speed",
      "items"
    ],
    "properties": {
      "_sample": {
        "$ref": "common.schema.json#/$defs/sample_flag"
      },
      "adm_cd": {
        "$ref": "common.schema.json#/$defs/adm_cd"
      },
      "speed": {
        "$ref": "common.schema.json#/$defs/speed"
      },
      "radius_m": {
        "type": "integer",
        "enum": [
          200,
          300,
          500
        ],
        "description": "flags·exposure_cnt·is_candidate 를 계산한 노출 반경(m). 요청의 radius 와 같다."
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "cw_id",
            "lat",
            "lon",
            "length_m",
            "green_s",
            "t_need_s",
            "gap_s",
            "flags",
            "exposure_cnt",
            "is_candidate"
          ],
          "properties": {
            "cw_id": {
              "type": "string",
              "description": "횡단보도 식별자(파이프라인이 부여)"
            },
            "lat": {
              "$ref": "common.schema.json#/$defs/lat"
            },
            "lon": {
              "$ref": "common.schema.json#/$defs/lon"
            },
            "length_m": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "횡단보도 연장(m)"
            },
            "green_s": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "기록된 녹색신호시간(초)"
            },
            "t_need_s": {
              "$ref": "common.schema.json#/$defs/seconds",
              "description": "7 + length_m / speed"
            },
            "gap_s": {
              "$ref": "common.schema.json#/$defs/seconds",
              "description": "t_need_s - green_s. 양수면 기록값이 기준식보다 짧음"
            },
            "flags": {
              "$ref": "common.schema.json#/$defs/exposure_flags"
            },
            "exposure_cnt": {
              "type": "integer",
              "minimum": 0
            },
            "is_candidate": {
              "type": "boolean",
              "description": "gap_s > 0 그리고 exposure_cnt >= 1"
            }
          }
        }
      }
    }
  },
  "common.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "common.schema.json",
    "title": "공통 정의",
    "$defs": {
      "adm_cd": {
        "type": "string",
        "pattern": "^[0-9]{8,10}$",
        "description": "읍면동 코드. 항상 문자열(앞자리 0 보존)."
      },
      "speed": {
        "type": "number",
        "enum": [
          0.7,
          0.8,
          1.0
        ],
        "description": "보행 속도 가정(m/s). 0.7 노인, 0.8 보행약자, 1.0 일반."
      },
      "target": {
        "type": "number",
        "enum": [
          0.85,
          0.9,
          0.95
        ],
        "description": "v2 목표 커버리지. 기본 0.85, 0.9·0.95 는 민감도. 파이프라인이 셋 다 미리 계산한다."
      },
      "ratio": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "비율(0~1). 화면에서 %로 변환한다."
      },
      "seconds": {
        "type": "number",
        "description": "초 단위 시간."
      },
      "lat": {
        "type": "number",
        "minimum": -90,
        "maximum": 90,
        "description": "위도(EPSG:4326)"
      },
      "lon": {
        "type": "number",
        "minimum": -180,
        "maximum": 180,
        "description": "경도(EPSG:4326)"
      },
      "sample_flag": {
        "type": "boolean",
        "description": "가상 샘플 데이터면 true. 실제 응답에는 없다."
      },
      "exposure_flags": {
        "type": "object",
        "description": "횡단보도 반경 안 노출 여부.",
        "required": [
          "senior_center",
          "market",
          "protect_zone",
          "crash_zone_past"
        ],
        "properties": {
          "senior_center": {
            "type": "boolean",
            "description": "경로당·마을회관"
          },
          "market": {
            "type": "boolean",
            "description": "전통시장"
          },
          "protect_zone": {
            "type": "boolean",
            "description": "노인·장애인 보호구역"
          },
          "crash_zone_past": {
            "type": "boolean",
            "description": "노인 보행사고 다발지역(과거 연도)"
          },
          "hospital": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "병원(P2). 데이터가 없으면 null."
          }
        }
      }
    }
  },
  "boundaries.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "boundaries.schema.json",
    "title": "읍면동 경계 정적 파일 (GeoJSON)",
    "description": "서버가 정적 파일로 제공한다(API 아님). 값은 담지 않고 /api/areas 의 adm_cd 로 붙인다. 출처: admdongkor(CC BY 4.0).",
    "type": "object",
    "required": [
      "type",
      "features"
    ],
    "properties": {
      "type": {
        "const": "FeatureCollection"
      },
      "features": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "type",
            "geometry",
            "properties"
          ],
          "properties": {
            "type": {
              "const": "Feature"
            },
            "geometry": {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "Polygon",
                    "MultiPolygon"
                  ]
                },
                "coordinates": {
                  "type": "array"
                }
              }
            },
            "properties": {
              "type": "object",
              "required": [
                "adm_cd",
                "adm_name",
                "sido",
                "sigungu"
              ],
              "properties": {
                "adm_cd": {
                  "$ref": "common.schema.json#/$defs/adm_cd"
                },
                "adm_name": {
                  "type": "string"
                },
                "sido": {
                  "type": "string"
                },
                "sigungu": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "areas.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "areas.schema.json",
    "title": "GET /api/areas?speed=&radius=&sido=&sigungu= | GET /api/areas?target=&radius=&sido=&sigungu=",
    "description": "읍면동별 집계. 지도 채색(F5), 사분면(F5), 상위 N(F7)에 쓴다. 두 가지 형태가 있다. speed 를 주면 v1(속도 하나 기준 gap>0 비율), target 을 주면 v2(3단계 기준 평균 추가 초, 결정 009). 한 응답에는 둘 중 하나만 있다.",
    "type": "object",
    "required": [
      "thresholds",
      "items"
    ],
    "properties": {
      "_sample": {
        "$ref": "common.schema.json#/$defs/sample_flag"
      },
      "speed": {
        "$ref": "common.schema.json#/$defs/speed"
      },
      "target": {
        "$ref": "common.schema.json#/$defs/target",
        "description": "v2. 목표 커버리지. 요청의 target 과 같다."
      },
      "radius_m": {
        "type": "integer",
        "enum": [
          200,
          300,
          500
        ],
        "description": "n_candidate·단계(1·2)를 계산한 반경(m). 요청의 radius 와 같다."
      },
      "min_sample": {
        "type": "integer",
        "minimum": 1,
        "description": "표본 하한(config.yaml min_sample). 분석 횡단보도가 이보다 적으면 low_sample. 화면의 표본 부족 기준 표시에 쓴다."
      },
      "thresholds": {
        "type": "object",
        "description": "사분면 경계선 기본값(중앙값, low_sample 제외). 화면에서 조절할 수 있다. v1 은 short_ratio_median, v2 는 mean_add_s_median 을 쓴다.",
        "required": [
          "ratio_65plus_median"
        ],
        "properties": {
          "short_ratio_median": {
            "$ref": "common.schema.json#/$defs/ratio"
          },
          "mean_add_s_median": {
            "type": "number",
            "minimum": 0,
            "description": "v2. 읍면동 평균 추가 초의 중앙값"
          },
          "ratio_65plus_median": {
            "$ref": "common.schema.json#/$defs/ratio"
          }
        }
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "adm_cd",
            "adm_name",
            "sido",
            "sigungu",
            "n_analyzed",
            "ratio_65plus",
            "quadrant",
            "low_sample"
          ],
          "properties": {
            "adm_cd": {
              "$ref": "common.schema.json#/$defs/adm_cd"
            },
            "adm_name": {
              "type": "string"
            },
            "sido": {
              "type": "string"
            },
            "sigungu": {
              "type": "string"
            },
            "n_analyzed": {
              "type": "integer",
              "minimum": 0,
              "description": "분석 가능한 횡단보도 수(v2 는 data_check 제외)"
            },
            "n_short": {
              "type": "integer",
              "minimum": 0,
              "description": "v1. gap > 0 인 횡단보도 수"
            },
            "short_ratio": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1,
              "description": "v1. n_short / n_analyzed. 분석 0건이면 null"
            },
            "mean_gap_s": {
              "type": [
                "number",
                "null"
              ],
              "description": "v1. gap > 0 인 횡단보도의 평균 짧은 초. 없으면 null"
            },
            "n_candidate": {
              "type": "integer",
              "minimum": 0,
              "description": "v1. 후보 횡단보도 수(gap > 0 그리고 노출 1개 이상)"
            },
            "mean_add_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "v2. 분석 횡단보도 전체(추가 0 포함)의 평균 추가 초. 채색·사분면 가로축. 분석 0건이면 null"
            },
            "n_add2": {
              "type": "integer",
              "minimum": 0,
              "description": "v2. 추가 초가 config add_seconds_threshold(2초) 이상인 횡단보도 수. 툴팁·상세용"
            },
            "coverage_now_mean": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/ratio"
                },
                {
                  "type": "null"
                }
              ],
              "description": "v2. coverage_now 평균(고령 보행자 기준)"
            },
            "coverage_required_mean": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/ratio"
                },
                {
                  "type": "null"
                }
              ],
              "description": "v2. coverage_required 평균(고령 보행자 기준)"
            },
            "ratio_65plus": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1,
              "description": "65세 이상 인구 비율. 인구 미매칭이면 null"
            },
            "quadrant": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "high_high",
                "high_low",
                "low_high",
                "low_low",
                null
              ],
              "description": "가로축(v1 짧음 비율, v2 평균 추가 초)_고령 비율 기준 사분면. high_high 가 점검 우선순위 후보. 값이 없으면 null"
            },
            "low_sample": {
              "type": "boolean",
              "description": "n_analyzed 가 표본 하한(min_sample) 미만이면 true. 회색 처리·순위 제외"
            }
          }
        }
      }
    },
    "oneOf": [
      {
        "description": "v1: 속도 하나 기준",
        "required": [
          "speed"
        ],
        "not": {
          "required": [
            "target"
          ]
        },
        "properties": {
          "thresholds": {
            "required": [
              "short_ratio_median"
            ]
          },
          "items": {
            "items": {
              "required": [
                "n_short",
                "short_ratio",
                "mean_gap_s",
                "n_candidate"
              ]
            }
          }
        }
      },
      {
        "description": "v2: 3단계 기준(목표 커버리지)",
        "required": [
          "target"
        ],
        "not": {
          "required": [
            "speed"
          ]
        },
        "properties": {
          "thresholds": {
            "required": [
              "mean_add_s_median"
            ]
          },
          "items": {
            "items": {
              "required": [
                "mean_add_s",
                "n_add2",
                "coverage_now_mean",
                "coverage_required_mean"
              ]
            }
          }
        }
      }
    ]
  },
  "candidates.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "candidates.schema.json",
    "title": "GET /api/crosswalks/candidates?bbox=&speed=&radius=",
    "description": "후보 횡단보도 점 레이어(GeoJSON FeatureCollection). bbox 는 minLon,minLat,maxLon,maxLat. radius 는 노출 반경(m, 기본 300).",
    "type": "object",
    "required": [
      "type",
      "features"
    ],
    "properties": {
      "_sample": {
        "$ref": "common.schema.json#/$defs/sample_flag"
      },
      "type": {
        "const": "FeatureCollection"
      },
      "speed": {
        "$ref": "common.schema.json#/$defs/speed"
      },
      "radius_m": {
        "type": "integer",
        "enum": [
          200,
          300,
          500
        ]
      },
      "features": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "type",
            "geometry",
            "properties"
          ],
          "properties": {
            "type": {
              "const": "Feature"
            },
            "geometry": {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "$ref": "common.schema.json#/$defs/lon"
                    },
                    {
                      "$ref": "common.schema.json#/$defs/lat"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "properties": {
              "type": "object",
              "required": [
                "cw_id",
                "adm_cd",
                "gap_s",
                "exposure_cnt"
              ],
              "properties": {
                "cw_id": {
                  "type": "string"
                },
                "adm_cd": {
                  "$ref": "common.schema.json#/$defs/adm_cd"
                },
                "gap_s": {
                  "$ref": "common.schema.json#/$defs/seconds"
                },
                "exposure_cnt": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "validation.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "validation.schema.json",
    "title": "GET /api/validation",
    "description": "검증 V1~V5 결과(F8). 아직 계산되지 않은 항목은 null. 결과가 기대와 달라도 그대로 담는다.",
    "type": "object",
    "required": [
      "v1",
      "v2",
      "v3",
      "v4",
      "v5"
    ],
    "properties": {
      "_sample": {
        "$ref": "common.schema.json#/$defs/sample_flag"
      },
      "v1": {
        "description": "현장 실측: 기록값 - 실측값(초)",
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "n",
              "mean_diff_s",
              "flash_included_n",
              "points"
            ],
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 0
              },
              "mean_diff_s": {
                "type": "number"
              },
              "flash_included_n": {
                "type": "integer",
                "minimum": 0,
                "description": "기록값이 점멸을 포함한 것으로 보이는 곳 수"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "cw_id",
                    "length_m",
                    "recorded_green_s",
                    "measured_green_s",
                    "measured_flash_s",
                    "diff_s"
                  ],
                  "properties": {
                    "cw_id": {
                      "type": "string"
                    },
                    "length_m": {
                      "type": "number"
                    },
                    "recorded_green_s": {
                      "type": "number"
                    },
                    "measured_green_s": {
                      "type": "number"
                    },
                    "measured_flash_s": {
                      "type": "number"
                    },
                    "diff_s": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "v2": {
        "description": "속도 민감도: 속도 쌍별 읍면동 순위 상관과 상위 N 중복",
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "top_n",
              "pairs"
            ],
            "properties": {
              "top_n": {
                "type": "integer",
                "minimum": 1
              },
              "pairs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "a",
                    "b",
                    "spearman",
                    "top_n_overlap"
                  ],
                  "properties": {
                    "a": {
                      "$ref": "common.schema.json#/$defs/speed"
                    },
                    "b": {
                      "$ref": "common.schema.json#/$defs/speed"
                    },
                    "spearman": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "top_n_overlap": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "v3": {
        "description": "사고다발지역 연관성(연도 분할, 무작위 비교)",
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "speed",
              "recent_years",
              "overlap_ratio",
              "ratio_vs_random",
              "p_value",
              "n_permutations",
              "random_distribution"
            ],
            "properties": {
              "speed": {
                "$ref": "common.schema.json#/$defs/speed"
              },
              "recent_years": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "overlap_ratio": {
                "$ref": "common.schema.json#/$defs/ratio"
              },
              "ratio_vs_random": {
                "type": "number",
                "minimum": 0
              },
              "p_value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "n_permutations": {
                "type": "integer",
                "minimum": 1
              },
              "random_distribution": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/ratio"
                },
                "description": "무작위 추출 겹침 비율들(히스토그램용)"
              }
            }
          }
        ]
      },
      "v4": {
        "description": "축 독립성과 이미 조정됐는가",
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "speed",
              "spearman",
              "by_group",
              "inside_outside"
            ],
            "properties": {
              "speed": {
                "$ref": "common.schema.json#/$defs/speed"
              },
              "spearman": {
                "type": "number",
                "minimum": -1,
                "maximum": 1,
                "description": "읍면동 짧음 비율과 65세 이상 비율의 순위 상관"
              },
              "by_group": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "group",
                    "spearman",
                    "n"
                  ],
                  "properties": {
                    "group": {
                      "type": "string",
                      "description": "시도명 또는 도시/농촌"
                    },
                    "spearman": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "n": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "inside_outside": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "facility",
                    "inside_short_ratio",
                    "outside_short_ratio"
                  ],
                  "properties": {
                    "facility": {
                      "type": "string",
                      "enum": [
                        "senior_center",
                        "market",
                        "protect_zone"
                      ]
                    },
                    "inside_short_ratio": {
                      "$ref": "common.schema.json#/$defs/ratio"
                    },
                    "outside_short_ratio": {
                      "$ref": "common.schema.json#/$defs/ratio"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "v5": {
        "description": "(선택) 보정 연관성 로지스틱 회귀. 하지 않으면 null",
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "coefficients"
            ],
            "properties": {
              "coefficients": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "term",
                    "estimate",
                    "ci_low",
                    "ci_high"
                  ],
                  "properties": {
                    "term": {
                      "type": "string"
                    },
                    "estimate": {
                      "type": "number"
                    },
                    "ci_low": {
                      "type": "number"
                    },
                    "ci_high": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "v6": {
        "description": "v2. 지하철 무임 비율: 대형 전통시장 근처 역은 주민 고령 비율을 감안해도 무임 비율이 높은가(2단계 시장 보정의 근거). 무임에는 장애인·유공자가 섞여 있고 역 근처만 본다. 없으면 null 또는 생략",
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "n_stations",
              "n_market_stations",
              "diff_pp",
              "p_value",
              "n_permutations",
              "seed",
              "uplift",
              "uplift_range"
            ],
            "properties": {
              "n_stations": {
                "type": "integer",
                "minimum": 0,
                "description": "비교한 역 수"
              },
              "n_market_stations": {
                "type": "integer",
                "minimum": 0,
                "description": "대형 시장 반경 안 역 수"
              },
              "diff_pp": {
                "type": "number",
                "description": "고령 비율 감안 후 무임 비율 차이(%p)"
              },
              "p_value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "단측 순열 검정 p"
              },
              "n_permutations": {
                "type": "integer",
                "minimum": 1
              },
              "seed": {
                "type": "integer"
              },
              "slope": {
                "type": "number",
                "description": "주민 고령 비율 1 증가당 무임 비율 증가(회귀 기울기)"
              },
              "uplift": {
                "type": "number",
                "description": "시장 보정 = diff_pp / 100 / slope (config market_elderly_uplift)"
              },
              "uplift_range": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2,
                "description": "민감도 범위 [최소, 최대] (config market_elderly_uplift_range)"
              },
              "sensitivity": {
                "type": "array",
                "description": "D13 민감도 표: 점포 기준·반경·연도·역 빼기를 바꿨을 때",
                "items": {
                  "type": "object",
                  "required": [
                    "param",
                    "value",
                    "diff_pp"
                  ],
                  "properties": {
                    "param": {
                      "type": "string",
                      "enum": [
                        "min_stores",
                        "radius_m",
                        "year",
                        "drop_station"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "description": "바꾼 값 (예: \"150\", \"2019\", \"수안\")"
                    },
                    "n_market_stations": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "diff_pp": {
                      "type": "number"
                    },
                    "p_value": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "uplift": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "v7": {
        "description": "v2. 정책 반영 점검: 기록 보행시간이 0.7 기준식과 같은 비율을 노인보호구역 반경 안 / 어린이보호구역 반경 안(노인 아님) / 둘 다 밖으로 비교. 없으면 null 또는 생략",
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "groups"
            ],
            "properties": {
              "groups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "group",
                    "radius_m",
                    "n",
                    "n_formula_07"
                  ],
                  "properties": {
                    "group": {
                      "type": "string",
                      "enum": [
                        "senior_zone",
                        "child_zone",
                        "outside"
                      ]
                    },
                    "radius_m": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "description": "그 구역을 본 반경(m). outside 는 null"
                    },
                    "n": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "대상 횡단보도 수"
                    },
                    "n_formula_07": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "그중 0.7식 수"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "meta.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "meta.schema.json",
    "title": "GET /api/meta",
    "description": "화면 하단 한계 고지·출처(F9)와 데이터 기준 정보.",
    "type": "object",
    "required": [
      "ref_month",
      "built_at",
      "coverage_ratio",
      "green_def_status",
      "sources",
      "limits_text"
    ],
    "properties": {
      "_sample": {
        "$ref": "common.schema.json#/$defs/sample_flag"
      },
      "ref_month": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}$",
        "description": "65세 이상 인구 기준 월"
      },
      "built_at": {
        "type": "string",
        "format": "date-time",
        "description": "파이프라인 실행 시각"
      },
      "coverage_ratio": {
        "$ref": "common.schema.json#/$defs/ratio",
        "description": "좌표가 있어 분석 가능한 횡단보도 비율"
      },
      "green_def_status": {
        "type": "string",
        "enum": [
          "unconfirmed",
          "includes_flash",
          "excludes_flash"
        ],
        "description": "녹색신호시간이 점멸을 포함하는지. unconfirmed 이면 화면에 '정의 확정 전'을 표시한다"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "url"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "data/download_log.csv 의 원본 ID (예: B1, R3, O1)"
            },
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "license": {
              "type": "string"
            },
            "modified": {
              "type": "string",
              "description": "출처 페이지에 적힌 수정일"
            },
            "as_of": {
              "type": "string",
              "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
              "description": "결과에 쓴 원본의 데이터 기준일(YYYY, YYYY-MM, YYYY-MM-DD). 화면의 \"이 결과는 언제 데이터 기준인가\" 표시용"
            },
            "update_cycle": {
              "type": "string",
              "enum": [
                "monthly",
                "quarterly",
                "semiannual",
                "yearly",
                "irregular",
                "unknown"
              ],
              "description": "출처가 밝힌(또는 확인한) 갱신 주기. 확인 못 했으면 unknown"
            },
            "fetched_at": {
              "type": "string",
              "format": "date",
              "description": "우리가 원본을 받은 날"
            },
            "role": {
              "type": "string",
              "description": "결과에서 맡는 역할(예: 분석 대상, 1단계, V3 검증)"
            }
          }
        }
      },
      "limits_text": {
        "type": "string",
        "description": "모든 화면 하단에 그대로 표시하는 한계 문구"
      },
      "coefficients": {
        "type": "array",
        "description": "v2. 화면 \"계수와 근거\"에 표시하는 계수. 값은 config.yaml 에서 온다",
        "items": {
          "type": "object",
          "required": [
            "key",
            "label",
            "value",
            "source",
            "level"
          ],
          "properties": {
            "key": {
              "type": "string",
              "description": "config.yaml 키 (예: market_elderly_uplift)"
            },
            "label": {
              "type": "string",
              "description": "화면에 쓰는 이름"
            },
            "value": {
              "type": "string",
              "description": "표시용 값과 단위 (예: \"0.137 (범위 0.063~0.157)\")"
            },
            "source": {
              "type": "string",
              "description": "근거 출처 (예: \"V6 지하철 무임 비율, 결정 009\")"
            },
            "level": {
              "type": "string",
              "enum": [
                "standard",
                "measured",
                "literature",
                "assumption"
              ],
              "description": "근거 수준: 공식 기준 / 우리 데이터로 측정 / 문헌 / 가정"
            }
          }
        }
      },
      "sensitivity": {
        "type": "array",
        "description": "v2. 계수를 바꿨을 때 결과 요약 (예: 고령자 속도 0.76m/s 로 다시 계산한 2초 이상 추가 수)",
        "items": {
          "type": "object",
          "required": [
            "label",
            "value"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "error.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "error.schema.json",
    "title": "오류 응답 (4xx, 5xx)",
    "description": "내부 경로·쿼리·스택 트레이스는 담지 않는다.",
    "type": "object",
    "required": [
      "error"
    ],
    "properties": {
      "error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "bad_request",
              "not_found",
              "method_not_allowed",
              "rate_limited",
              "internal_error"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "static_manifest.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "static_manifest.schema.json",
    "title": "정적 묶음 manifest.json",
    "description": "서버 없이 데모하는 정적 묶음(F18)의 목차. 묶음에 들어 있는 속도·반경 조합과 상세가 있는 읍면동을 적는다. 여기 없는 조합은 '아직 적재되지 않음'으로 보여준다(빈 결과로 보이지 않게). 파일 구성은 README '정적 묶음'.",
    "type": "object",
    "required": [
      "built_at",
      "results"
    ],
    "additionalProperties": false,
    "properties": {
      "_sample": {
        "$ref": "common.schema.json#/$defs/sample_flag"
      },
      "built_at": {
        "type": "string",
        "format": "date-time",
        "description": "묶음을 내보낸 시각"
      },
      "results": {
        "type": "array",
        "description": "묶음에 들어 있는 속도·반경 조합. 조합마다 areas·candidates 파일이 있다.",
        "items": {
          "type": "object",
          "required": [
            "speed",
            "radius_m",
            "details"
          ],
          "additionalProperties": false,
          "properties": {
            "speed": {
              "$ref": "common.schema.json#/$defs/speed"
            },
            "radius_m": {
              "type": "integer",
              "enum": [
                200,
                300,
                500
              ]
            },
            "points": {
              "type": "boolean",
              "description": "전체 횡단보도 점 파일(points/{speed}_{radius}.json)이 있으면 true. 없으면 생략하거나 false"
            },
            "details": {
              "type": "array",
              "description": "이 조합에서 상세(crosswalks) 파일이 있는 읍면동 코드",
              "items": {
                "$ref": "common.schema.json#/$defs/adm_cd"
              },
              "uniqueItems": true
            }
          }
        }
      },
      "results_v2": {
        "type": "array",
        "description": "v2(결정 009) 목표 커버리지·반경 조합. 조합마다 areas_v2/{target}_{radius}.json 이 있다. 없으면 생략",
        "items": {
          "type": "object",
          "required": [
            "target",
            "radius_m"
          ],
          "additionalProperties": false,
          "properties": {
            "target": {
              "$ref": "common.schema.json#/$defs/target"
            },
            "radius_m": {
              "type": "integer",
              "enum": [
                200,
                300,
                500
              ]
            },
            "points": {
              "type": "boolean",
              "description": "points_v2/{target}_{radius}.json 이 있으면 true"
            }
          }
        }
      }
    }
  },
  "points.schema.json": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "points.schema.json",
    "title": "GET /api/crosswalks?bbox=&speed=&radius=",
    "description": "전체 횡단보도 점 레이어(GeoJSON FeatureCollection). 후보만이 아니라 분석한 모든 횡단보도(status=analyzed)와, 좌표는 있지만 정제(F1)에서 제외된 횡단보도(status=excluded), 기록 방식 확인이 필요한 횡단보도(status=data_check)를 담는다. target 을 주면 v2 필드(결정 009 3단계 기준)를 함께 담는다. 지도 점 색·필터·정보 카드에 쓴다. bbox 는 minLon,minLat,maxLon,maxLat.",
    "type": "object",
    "required": [
      "type",
      "features"
    ],
    "properties": {
      "_sample": {
        "$ref": "common.schema.json#/$defs/sample_flag"
      },
      "type": {
        "const": "FeatureCollection"
      },
      "speed": {
        "$ref": "common.schema.json#/$defs/speed"
      },
      "radius_m": {
        "type": "integer",
        "enum": [
          200,
          300,
          500
        ],
        "description": "flags·exposure_cnt·is_candidate 를 계산한 노출 반경(m)."
      },
      "target": {
        "$ref": "common.schema.json#/$defs/target",
        "description": "v2 필드(tier~reason_parts)를 계산한 목표 커버리지. 요청의 target 과 같다. v2 필드가 없는 응답이면 생략"
      },
      "features": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "type",
            "geometry",
            "properties"
          ],
          "properties": {
            "type": {
              "const": "Feature"
            },
            "geometry": {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "$ref": "common.schema.json#/$defs/lon"
                    },
                    {
                      "$ref": "common.schema.json#/$defs/lat"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "properties": {
              "type": "object",
              "required": [
                "cw_id",
                "adm_cd",
                "status",
                "length_m",
                "green_s",
                "t_need_s",
                "gap_s",
                "flags",
                "exposure_cnt",
                "is_candidate",
                "exclude_reason"
              ],
              "properties": {
                "cw_id": {
                  "type": "string"
                },
                "adm_cd": {
                  "$ref": "common.schema.json#/$defs/adm_cd"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "analyzed",
                    "excluded",
                    "data_check"
                  ],
                  "description": "analyzed: 기준식과 비교함. excluded: 정제에서 제외(사유는 exclude_reason). data_check: 기록 보행시간이 일반 기준식(7 + L/1.0)보다도 짧아 기록 방식 확인 전까지 집계에서 뺌(사유는 check_reason). data_check 는 t_need_s·gap_s·v2 시간 값이 null, is_candidate 는 false."
                },
                "length_m": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "횡단보도 연장(m). 결측이면 null"
                },
                "green_s": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "기록된 녹색신호시간(초). 결측이면 null"
                },
                "t_need_s": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "기준식 필요 시간(초) = 진입 시간 + 연장/속도. excluded 면 null"
                },
                "gap_s": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "t_need_s - green_s. 양수면 기록값이 기준식보다 짧음. excluded 면 null"
                },
                "flags": {
                  "anyOf": [
                    {
                      "$ref": "common.schema.json#/$defs/exposure_flags"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "노출 여부. excluded 라도 계산할 수 있으면 채운다"
                },
                "exposure_cnt": {
                  "type": "integer",
                  "minimum": 0
                },
                "is_candidate": {
                  "type": "boolean",
                  "description": "gap_s > 0 그리고 exposure_cnt >= 1. excluded 는 false"
                },
                "exclude_reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "green_missing",
                    "length_missing",
                    "green_out_of_range",
                    "length_out_of_range",
                    null
                  ],
                  "description": "excluded 의 사유(F1 제외 사유 표와 같은 기준). analyzed 면 null"
                },
