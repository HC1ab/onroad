# 복사해서 .env 로 만들고 값을 채운다. .env 는 Git에 올라가지 않는다.
# 값은 문서·이슈·PR·채팅·스크린샷에 쓰지 않는다.
DATA_GO_KR_KEY_R4=
DATA_GO_KR_KEY_O4=

# 서버·DB (로컬은 .env.local 로 복사해 사용, 운영은 .env.prod)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=onroad
DB_USER=onroad
DB_PASSWORD=
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173
# 프론트: real(API 사용) 또는 mock(contracts/samples 사용)
VITE_API_MODE=real
