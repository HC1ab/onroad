{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meta.schema.json",
  "title": "GET /api/meta",
  "description": "화면 하단 한계 고지·출처(F9)와 데이터 기준 정보.",
  "type": "object",
  "required": ["ref_month", "built_at", "coverage_ratio", "green_def_status", "sources", "limits_text"],
  "properties": {
    "_sample": { "$ref": "common.schema.json#/$defs/sample_flag" },
    "ref_month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "description": "65세 이상 인구 기준 월" },
    "built_at": { "type": "string", "format": "date-time", "description": "파이프라인 실행 시각" },
    "coverage_ratio": { "$ref": "common.schema.json#/$defs/ratio", "description": "좌표가 있어 분석 가능한 횡단보도 비율" },
    "green_def_status": {
      "type": "string",
      "enum": ["unconfirmed", "includes_flash", "excludes_flash"],
      "description": "녹색신호시간이 점멸을 포함하는지. unconfirmed 이면 화면에 '정의 확정 전'을 표시한다"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "id": { "type": "string", "description": "data/download_log.csv 의 원본 ID (예: B1, R3, O1)" },
          "name": { "type": "string" },
          "url": { "type": "string" },
          "license": { "type": "string" },
          "modified": { "type": "string", "description": "출처 페이지에 적힌 수정일" },
          "as_of": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$", "description": "결과에 쓴 원본의 데이터 기준일(YYYY, YYYY-MM, YYYY-MM-DD). 화면의 \"이 결과는 언제 데이터 기준인가\" 표시용" },
          "update_cycle": {
            "type": "string",
            "enum": ["monthly", "quarterly", "semiannual", "yearly", "irregular", "unknown"],
            "description": "출처가 밝힌(또는 확인한) 갱신 주기. 확인 못 했으면 unknown"
          },
          "fetched_at": { "type": "string", "format": "date", "description": "우리가 원본을 받은 날" },
          "role": { "type": "string", "description": "결과에서 맡는 역할(예: 분석 대상, 1단계, V3 검증)" }
        }
      }
    },
    "limits_text": { "type": "string", "description": "모든 화면 하단에 그대로 표시하는 한계 문구" },
    "coefficients": {
      "type": "array",
      "description": "v2. 화면 \"계수와 근거\"에 표시하는 계수. 값은 config.yaml 에서 온다",
      "items": {
        "type": "object",
        "required": ["key", "label", "value", "source", "level"],
        "properties": {
          "key": { "type": "string", "description": "config.yaml 키 (예: market_elderly_uplift)" },
          "label": { "type": "string", "description": "화면에 쓰는 이름" },
          "value": { "type": "string", "description": "표시용 값과 단위 (예: \"0.137 (범위 0.063~0.157)\")" },
          "source": { "type": "string", "description": "근거 출처 (예: \"V6 지하철 무임 비율, 결정 009\")" },
          "level": { "type": "string", "enum": ["standard", "measured", "literature", "assumption"], "description": "근거 수준: 공식 기준 / 우리 데이터로 측정 / 문헌 / 가정" }
        }
      }
    },
    "sensitivity": {
      "type": "array",
      "description": "v2. 계수를 바꿨을 때 결과 요약 (예: 고령자 속도 0.76m/s 로 다시 계산한 2초 이상 추가 수)",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    }
  }
}
