{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boundaries.schema.json",
  "title": "읍면동 경계 정적 파일 (GeoJSON)",
  "description": "서버가 정적 파일로 제공한다(API 아님). 값은 담지 않고 /api/areas 의 adm_cd 로 붙인다. 출처: admdongkor(CC BY 4.0).",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "geometry", "properties"],
        "properties": {
          "type": { "const": "Feature" },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "enum": ["Polygon", "MultiPolygon"] },
              "coordinates": { "type": "array" }
            }
          },
          "properties": {
            "type": "object",
            "required": ["adm_cd", "adm_name", "sido", "sigungu"],
            "properties": {
              "adm_cd": { "$ref": "common.schema.json#/$defs/adm_cd" },
              "adm_name": { "type": "string" },
              "sido": { "type": "string" },
              "sigungu": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
